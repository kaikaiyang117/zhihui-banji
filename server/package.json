{
  "name": "meimei-workbench-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "美美大王工作台 Node.js/TypeScript 后端（MIG-02 起逐步替换 FastAPI）",
  "main": "dist/entry.js",
  "scripts": {
